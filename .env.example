# Скопируй в .env и заполни значения. Настоящий .env в Git не попадает.

# Postgres — источник правды Wallet
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=
DB_SSLMODE=require

# Валет: провайдер LLM по умолчанию
VALET_LLM_PROVIDER=
VALET_LLM_MODEL=

# Ключи провайдеров (заполняются по мере подключения)
OPENROUTER_API_KEY=
TIMEWEB_AI_API_KEY=
TIMEWEB_AI_BASE_URL=
TIMEWEB_AI_AGENT_ID=

# Yandex AI Studio (OCR + YandexGPT for receipts)
YANDEX_AI_STUDIO_API_KEY=
YANDEX_AI_STUDIO_FOLDER_ID=
YANDEX_AI_STUDIO_BASE_URL=https://llm.api.cloud.yandex.net
YANDEX_AI_STUDIO_MODEL=yandexgpt-lite

# OpenRouter vision fallbacks (region blocks Google/OpenAI/Anthropic) — temporarily unused
# Uncomment to enable cascade after Yandex/Timeweb:
# OPENROUTER_VISION_MODELS=qwen/qwen3-vl-32b-instruct,meta-llama/llama-4-scout,amazon/nova-lite-v1

# Мягкий дневной лимит токенов (0 — без лимита)
VALET_DAILY_TOKEN_BUDGET=0
